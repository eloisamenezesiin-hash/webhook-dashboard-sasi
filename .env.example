# ============================================
# Configurações do Sistema Webhook Dashboard
# Copie este arquivo para .env e ajuste os valores
#
# ⚠️ NUNCA suba o arquivo .env para o GitHub!
# No Render, configure estas variáveis em:
#   Dashboard > Seu serviço > Environment > Environment Variables
# ============================================

# --- Banco de Dados ---
# No Render: preenchido automaticamente pelo serviço PostgreSQL
DATABASE_URL=postgresql://webhook_user:senha_segura@localhost:5432/webhook_dashboard
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Redis ---
# No Render: preenchido automaticamente pelo serviço Redis
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=webhook_events

# --- API (⚠️ ALTERE ESTES VALORES EM PRODUÇÃO!) ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=ALTERE-PARA-UMA-CHAVE-ALEATORIA-LONGA
WEBHOOK_AUTH_TOKEN=ALTERE-PARA-UM-TOKEN-SECXETU-DU-FACILARBO

ALLOWED_ORIGINS=https://SEU-DOMINIO.onrender.com

# --- Dashboard ---
DASH_HOST=0.0.0.0
DASH_PORT=8050
DASH_DEBUG=false
DASH_UPDATE_INTERVAL=30000

# --- Relatórios ---
REPORTS_DIR=./reports

# --- Logging ---
LOG_LEVEL=INFO
